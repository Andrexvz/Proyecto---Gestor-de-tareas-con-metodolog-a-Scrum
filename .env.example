# --- Agile Velocity AI (Backend Multi-Proveedor) ---
# Proveedor activo: auto | gemini | groq | openai | ollama
AI_PROVIDER="auto"

# Google Gemini API (Plan gratuito en Google AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_MODEL_FAST="gemini-2.5-flash"
AI_MODEL_DEEP="gemini-2.5-pro"

# Alternativa gratuita de alta velocidad: Groq (OpenAI-compatible)
GROQ_API_KEY=""
GROQ_MODEL_FAST="openai/gpt-oss-20b"
GROQ_MODEL_DEEP="openai/gpt-oss-120b"

# Alternativa OpenAI / Ollama local
OPENAI_API_KEY=""
OLLAMA_ENABLED="false"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Control de consumo y límites por usuario
AI_RPM_LIMIT="20"
AI_DAILY_TOKEN_BUDGET="100000"
AI_TIMEOUT_SECONDS="25"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Automate GitHub Issues (Jules Fleet) ---
# Your Jules API key (required for dispatching sessions)
JULES_API_KEY=""

# GitHub personal access token with repo access (required for issue fetching and PR merge)
GITHUB_TOKEN=""

# Optional: override the base branch for fleet sessions (defaults to current branch)
# FLEET_BASE_BRANCH="main"
